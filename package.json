{
  "name": "concentrate-provider",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Concentrate.ai provider for OpenClaw: Responses, tools, reasoning, structured output and image input.",
  "license": "MIT",
  "files": [
    "index.mjs",
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "check": "node --check index.mjs && node --check src/catalog.mjs && node --check src/provider.mjs && node --check test/transport.synthetic.mjs",
    "manifest": "node scripts/generate-manifest.mjs",
    "test:transport": "node --test --test-concurrency=1 test/transport.synthetic.mjs"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "peerDependencies": {
    "openclaw": "2026.9.4"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "openclaw": {
    "extensions": [
      "./index.mjs"
    ],
    "providers": [
      "concentrate"
    ],
    "compat": {
      "pluginApi": ">=2026.9.4",
      "minGatewayVersion": "2026.9.4"
    },
    "build": {
      "openclawVersion": "2026.9.4"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arcacomputer/openclaw-concentrateai.git"
  }
}
